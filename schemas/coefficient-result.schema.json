        "root_brackets": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "array", "minItems": 3, "maxItems": 3}},
        "numpy_version": {"type": "string", "minLength": 1}, "scipy_version": {"type": "string", "minLength": 1}, "converged": {"const": true}
      }
    },
    "bayesian_meta_posterior": {
