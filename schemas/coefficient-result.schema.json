        "target": {"enum": ["population_mean", "between_study_tau", "between_study_tau_squared", "true_effect_in_new_exchangeable_study"]},
        "median": {"type": "number"}, "null_value": {"type": "number"}, "interval": {"$ref": "#/$defs/bayesian_meta_interval"},
