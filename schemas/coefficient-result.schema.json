      "properties": {
        "mean_family": {"const": "normal"}, "mean_location": {"type": "number"}, "mean_scale": {"type": "number", "exclusiveMinimum": 0},
        "mean_prior_95_interval": {"$ref": "#/$defs/bayesian_meta_prior_interval"},
