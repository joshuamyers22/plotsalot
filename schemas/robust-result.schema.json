{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotsalot.invalid/schemas/robust-result-v2.json",
  "title": "plotsalot M6A robust result variants",
  "description": "Top-level JSON shape; immutable Python constructors enforce cross-field statistical invariants.",
  "oneOf": [
    { "$ref": "#/$defs/oneSample" },
    { "$ref": "#/$defs/dotPlot" },
    { "$ref": "#/$defs/correlation" },
    { "$ref": "#/$defs/correlationMatrix" },
    { "$ref": "#/$defs/comparison" }
  ],
  "$defs": {
    "oneSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analysis", "mode", "column", "sample", "method", "estimate", "test", "interval", "effect_size", "limits", "warnings"],
      "properties": {
        "schema_version": { "const": 2 },
        "analysis": { "enum": ["gghistostats_one_sample_robust", "ggdotplotstats_one_sample_robust"] },
        "mode": { "const": "robust" },
        "column": { "type": "string", "minLength": 1 },
        "sample": { "type": "object" },
        "method": { "type": "object" },
        "estimate": { "type": "object" },
        "test": { "type": "object" },
        "interval": { "type": "object" },
        "effect_size": { "type": "object" },
        "limits": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "dotPlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analysis", "mode", "x", "label_column", "sample", "method", "one_sample", "estimates", "limits", "warnings"],
      "properties": {
        "schema_version": { "const": 2 },
        "analysis": { "const": "ggdotplotstats_one_sample_robust" },
        "mode": { "const": "robust" },
        "x": { "type": "string", "minLength": 1 },
        "label_column": { "type": "string", "minLength": 1 },
        "sample": { "type": "object" },
        "method": { "type": "object" },
        "one_sample": { "type": "object" },
        "estimates": { "type": "array", "minItems": 1 },
        "limits": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analysis", "mode", "x", "y", "sample", "method", "x_kernel", "y_kernel", "winsorized_covariance", "estimate", "test", "interval", "resampling", "limits", "warnings"],
      "properties": {
        "schema_version": { "const": 2 },
        "analysis": { "const": "ggscatterstats_winsorized" },
        "mode": { "const": "robust" },
        "x": { "type": "string", "minLength": 1 },
        "y": { "type": "string", "minLength": 1 },
        "sample": { "type": "object" },
        "method": { "type": "object" },
        "x_kernel": { "type": "object" },
        "y_kernel": { "type": "object" },
        "winsorized_covariance": { "type": "number" },
        "estimate": { "type": "number", "minimum": -1, "maximum": 1 },
        "test": { "type": "object" },
        "interval": { "type": "object" },
        "resampling": { "type": "object" },
        "limits": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "correlationMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analysis", "mode", "columns", "method", "p_adjust", "sig_level", "cells", "limits", "maximum_resample_work", "calculated_resample_work", "warnings"],
      "properties": {
        "schema_version": { "const": 2 },
        "analysis": { "const": "ggcorrmat_winsorized" },
        "mode": { "const": "robust" },
        "columns": { "type": "array", "minItems": 2, "maxItems": 50, "uniqueItems": true },
        "method": { "type": "object" },
        "p_adjust": { "enum": ["holm", "none"] },
        "sig_level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "cells": { "type": "array", "minItems": 4 },
        "limits": { "type": "object" },
        "maximum_resample_work": { "type": "integer", "minimum": 1, "maximum": 500000000 },
        "calculated_resample_work": { "type": "integer", "minimum": 1 },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "analysis", "mode", "design", "x", "y", "subject_id", "sample", "method", "levels", "omnibus", "estimate", "interval", "effect_size", "pairwise", "p_adjust", "pairwise_alpha", "pairwise_display", "correction", "limits", "warnings"],
      "properties": {
        "schema_version": { "const": 2 },
        "analysis": { "enum": ["ggbetweenstats_robust", "ggwithinstats_robust"] },
        "mode": { "const": "robust" },
        "design": { "enum": ["between", "within"] },
        "x": { "type": "string", "minLength": 1 },
        "y": { "type": "string", "minLength": 1 },
        "subject_id": { "type": ["string", "null"] },
        "sample": { "type": "object" },
        "method": { "type": "object" },
        "levels": { "type": "array", "minItems": 2, "maxItems": 20 },
        "omnibus": { "type": "object" },
        "estimate": { "type": ["number", "null"] },
        "interval": { "type": ["object", "null"] },
        "effect_size": { "type": "object" },
        "pairwise": { "type": "array" },
        "p_adjust": { "enum": ["holm", "none"] },
        "pairwise_alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "pairwise_display": { "enum": ["significant", "non-significant", "all", "none"] },
        "correction": { "type": ["object", "null"] },
        "limits": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
