{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotsalot.dev/schemas/categorical-result.schema.json",
  "title": "plotsalot categorical result schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis", "design", "x", "y", "counts", "sample",
    "x_levels", "y_levels", "cells", "row_totals", "column_totals", "ratio",
    "omnibus", "effect", "adequacy", "pairwise", "strata", "p_adjust",
    "alpha", "conf_level", "pairwise_display", "proportion_test", "limits", "warnings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "analysis": {"const": "categorical_classical"},
    "design": {"enum": ["one_way", "independent", "paired"]},
    "x": {"type": "string", "minLength": 1},
    "y": {"type": ["string", "null"], "minLength": 1},
    "counts": {"type": ["string", "null"], "minLength": 1},
    "sample": {"$ref": "#/$defs/sample"},
    "x_levels": {"type": "array", "minItems": 2, "maxItems": 20, "items": {"$ref": "#/$defs/scalar"}},
    "y_levels": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/scalar"}},
    "cells": {"type": "array", "minItems": 2, "maxItems": 400, "items": {"$ref": "#/$defs/cell"}},
    "row_totals": {"type": "array", "minItems": 2, "maxItems": 20, "items": {"type": "integer", "minimum": 0}},
    "column_totals": {"type": "array", "maxItems": 20, "items": {"type": "integer", "minimum": 0}},
    "ratio": {
      "oneOf": [
        {"type": "array", "minItems": 2, "maxItems": 20, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}},
        {"type": "null"}
      ]
    },
    "omnibus": {"$ref": "#/$defs/test"},
    "effect": {"$ref": "#/$defs/effect"},
    "adequacy": {"oneOf": [{"$ref": "#/$defs/adequacy"}, {"type": "null"}]},
    "pairwise": {"type": "array", "maxItems": 190, "items": {"$ref": "#/$defs/followup"}},
    "strata": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/followup"}},
    "p_adjust": {"enum": ["holm", "none"]},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "conf_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "pairwise_display": {"enum": ["significant", "non-significant", "all", "none"]},
    "proportion_test": {"type": "boolean"},
    "limits": {"$ref": "#/$defs/limits"},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "scalar": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "integer"}, {"type": "number"}, {"type": "boolean"}]},
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["input_rows", "analyzed_rows", "weighted_total", "dropped_null_x_rows", "dropped_null_y_rows", "dropped_null_count_rows"],
      "properties": {
        "input_rows": {"type": "integer", "minimum": 1},
        "analyzed_rows": {"type": "integer", "minimum": 1},
        "weighted_total": {"type": "integer", "minimum": 1},
        "dropped_null_x_rows": {"type": "integer", "minimum": 0},
        "dropped_null_y_rows": {"type": "integer", "minimum": 0},
        "dropped_null_count_rows": {"type": "integer", "minimum": 0}
      }
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["x_level", "y_level", "observed", "expected", "displayed_proportion", "joint_proportion", "pearson_residual", "contribution"],
      "properties": {
        "x_level": {"$ref": "#/$defs/scalar"},
        "y_level": {"anyOf": [{"$ref": "#/$defs/scalar"}, {"type": "null"}]},
        "observed": {"type": "integer", "minimum": 0},
        "expected": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "displayed_proportion": {"type": "number", "minimum": 0, "maximum": 1},
        "joint_proportion": {"type": "number", "minimum": 0, "maximum": 1},
        "pearson_residual": {"type": ["number", "null"]},
        "contribution": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "test": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "statistic", "df", "p_value"],
      "properties": {
        "name": {"enum": ["pearson_chi_square_goodness_of_fit", "pearson_chi_square_independence", "exact_binomial_paired"]},
        "statistic": {"type": "number", "minimum": 0},
        "df": {"type": "number", "minimum": 0},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "method", "level", "low", "high"],
      "properties": {
        "target": {"enum": ["cohen_w", "cramers_v", "cohen_g"]},
        "method": {"enum": ["noncentral_chi_square_equal_tail_bounded", "clopper_pearson_transformed"]},
        "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "low": {"type": "number"},
        "high": {"type": "number"}
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "interval"],
      "properties": {
        "name": {"enum": ["cohen_w", "cramers_v", "cohen_g"]},
        "value": {"type": "number"},
        "interval": {"$ref": "#/$defs/interval"}
      }
    },
    "adequacy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum", "cells_below_five", "total_cells", "rule"],
      "properties": {
        "minimum": {"type": "number", "minimum": 1},
        "cells_below_five": {"type": "integer", "minimum": 0},
        "total_cells": {"type": "integer", "minimum": 1},
        "rule": {"enum": ["all_at_least_five_2x2", "at_least_80_percent_at_least_five"]}
      }
    },
    "followup": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "left", "right", "observed", "shape", "test", "effect", "adjusted_p_value", "significant", "adequacy"],
      "properties": {
        "family": {"enum": ["pairwise", "stratum"]},
        "left": {"$ref": "#/$defs/scalar"},
        "right": {"anyOf": [{"$ref": "#/$defs/scalar"}, {"type": "null"}]},
        "observed": {"type": "array", "minItems": 2, "maxItems": 40, "items": {"type": "integer", "minimum": 0}},
        "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "test": {"$ref": "#/$defs/test"},
        "effect": {"$ref": "#/$defs/effect"},
        "adjusted_p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "significant": {"type": "boolean"},
        "adequacy": {"$ref": "#/$defs/adequacy"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_rows", "maximum_groups", "maximum_variables", "maximum_labels", "maximum_levels", "maximum_pairwise_hypotheses", "maximum_rendered_observations", "maximum_subject_paths", "maximum_panels", "maximum_cells", "maximum_total_count"],
      "properties": {
        "maximum_rows": {"type": "integer", "minimum": 1},
        "maximum_groups": {"type": "integer", "minimum": 1},
        "maximum_variables": {"type": "integer", "minimum": 1},
        "maximum_labels": {"type": "integer", "minimum": 1},
        "maximum_levels": {"type": "integer", "minimum": 2, "maximum": 20},
        "maximum_pairwise_hypotheses": {"type": "integer", "minimum": 1},
        "maximum_rendered_observations": {"type": "null"},
        "maximum_subject_paths": {"type": "null"},
        "maximum_panels": {"type": "null"},
        "maximum_cells": {"type": "integer", "minimum": 1, "maximum": 400},
        "maximum_total_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
