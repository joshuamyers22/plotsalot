{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plotsalot.invalid/schemas/dotplot-result-v1.json",
  "title": "plotsalot labeled dot-plot result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis", "x", "label_column", "sample", "one_sample", "estimates", "limits", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "analysis": {"const": "ggdotplotstats_one_sample_parametric"},
    "x": {"type": "string", "minLength": 1},
    "label_column": {"type": "string", "minLength": 1},
    "sample": {"$ref": "analysis-result.schema.json#/$defs/sampleAudit"},
    "one_sample": {"$ref": "analysis-result.schema.json"},
    "estimates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "sample", "value", "standard_deviation", "interval", "warnings"],
        "properties": {
          "label": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {"type": "integer"},
              {"type": "number"},
              {"type": "boolean"}
            ]
          },
          "sample": {"$ref": "analysis-result.schema.json#/$defs/sampleAudit"},
          "value": {"type": "number"},
          "standard_deviation": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "interval": {
            "oneOf": [
              {"$ref": "analysis-result.schema.json#/$defs/meanInterval"},
              {"type": "null"}
            ]
          },
          "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_rows", "maximum_groups", "maximum_variables", "maximum_labels"],
      "properties": {
        "maximum_rows": {"type": "integer", "minimum": 1},
        "maximum_groups": {"type": "null"},
        "maximum_variables": {"type": "null"},
        "maximum_labels": {"type": "integer", "minimum": 1}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
